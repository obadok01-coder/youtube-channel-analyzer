# YouTube Data API v3 key (get from https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI API key (for title pattern analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (for transcript analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API key (optional fallback for title analysis)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
